# offline = deterministic simulated model (no key, no cost). For live runs pick one free tier:
LLM_PROVIDER=offline
# LLM_PROVIDER=groq        GROQ_API_KEY=...        SMALL_MODEL=llama-3.1-8b-instant  LARGE_MODEL=llama-3.3-70b-versatile
# LLM_PROVIDER=gemini      GEMINI_API_KEY=...      LARGE_MODEL=gemini-2.0-flash
# LLM_PROVIDER=openrouter  OPENROUTER_API_KEY=...  LARGE_MODEL=<any :free model>
# Model names change; check the provider's current free-tier list before running.
